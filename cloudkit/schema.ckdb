DEFINE SCHEMA

    RECORD TYPE CD_Act (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        "CD_entityName" STRING QUERYABLE,
        "CD_arrivesBy" TIMESTAMP,
        "CD_cardFile" STRING,
        "CD_cardFile_ckAsset" ASSET,
        "CD_completedAt" TIMESTAMP,
        "CD_confirmedRaw" STRING,
        "CD_confirmedRaw_ckAsset" ASSET,
        "CD_createdAt" TIMESTAMP,
        "CD_dinnerDate" TIMESTAMP,
        "CD_fromNote" ENCRYPTED STRING,
        "CD_fromNote_ckAsset" ASSET,
        "CD_id" STRING,
        "CD_kindRaw" STRING,
        "CD_kindRaw_ckAsset" ASSET,
        "CD_label" ENCRYPTED STRING,
        "CD_label_ckAsset" ASSET,
        "CD_moment" STRING,
        "CD_note" ENCRYPTED STRING,
        "CD_note_ckAsset" ASSET,
        "CD_orderNumber" ENCRYPTED STRING,
        "CD_orderNumber_ckAsset" ASSET,
        "CD_ownerIDs" STRING,
        "CD_ownerIDs_ckAsset" ASSET,
        "CD_photoFile" STRING,
        "CD_photoFile_ckAsset" ASSET,
        "CD_roleRaw" STRING,
        "CD_roleRaw_ckAsset" ASSET,
        "CD_sortOrder" INT64,
        "CD_step" STRING,
        "CD_step_ckAsset" ASSET,
        "CD_title" ENCRYPTED STRING,
        "CD_title_ckAsset" ASSET,
        "CD_trackingURL" ENCRYPTED STRING,
        "CD_trackingURL_ckAsset" ASSET,
        "CD_wishID" STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_LedgerEntry (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        "CD_entityName" STRING QUERYABLE,
        "CD_cardFile" STRING,
        "CD_cardFile_ckAsset" ASSET,
        "CD_createdAt" TIMESTAMP,
        "CD_id" STRING,
        "CD_line" ENCRYPTED STRING,
        "CD_line_ckAsset" ASSET,
        "CD_momentID" STRING,
        "CD_occasionTypeRaw" STRING,
        "CD_occasionTypeRaw_ckAsset" ASSET,
        "CD_person" STRING,
        "CD_personName" ENCRYPTED STRING,
        "CD_personName_ckAsset" ASSET,
        "CD_photoFile" STRING,
        "CD_photoFile_ckAsset" ASSET,
        "CD_what" ENCRYPTED STRING,
        "CD_what_ckAsset" ASSET,
        "CD_year" INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Moment (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        "CD_entityName" STRING QUERYABLE,
        "CD_callStartedAt" TIMESTAMP,
        "CD_dueDate" TIMESTAMP,
        "CD_familyGiftURL" ENCRYPTED STRING,
        "CD_familyGiftURL_ckAsset" ASSET,
        "CD_familyInviteURL" ENCRYPTED STRING,
        "CD_familyInviteURL_ckAsset" ASSET,
        "CD_familyOwnerKey" ENCRYPTED STRING,
        "CD_familyOwnerKey_ckAsset" ASSET,
        "CD_familyPageID" ENCRYPTED STRING,
        "CD_familyPageID_ckAsset" ASSET,
        "CD_headsUpAt" TIMESTAMP,
        "CD_id" STRING,
        "CD_missedAt" TIMESTAMP,
        "CD_occasion" STRING,
        "CD_photoPromptShown" INT64,
        "CD_statusRaw" STRING,
        "CD_statusRaw_ckAsset" ASSET,
        "CD_year" INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Occasion (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        "CD_entityName" STRING QUERYABLE,
        "CD_birthYear" ENCRYPTED INT64,
        "CD_day" ENCRYPTED INT64,
        "CD_extraRecipientIDs" STRING,
        "CD_extraRecipientIDs_ckAsset" ASSET,
        "CD_id" STRING,
        "CD_month" ENCRYPTED INT64,
        "CD_partnerName" ENCRYPTED STRING,
        "CD_partnerName_ckAsset" ASSET,
        "CD_person" STRING,
        "CD_ringOverrideRaw" STRING,
        "CD_ringOverrideRaw_ckAsset" ASSET,
        "CD_typeRaw" STRING,
        "CD_typeRaw_ckAsset" ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Person (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        "CD_entityName" STRING QUERYABLE,
        "CD_contactID" ENCRYPTED STRING,
        "CD_contactID_ckAsset" ASSET,
        "CD_createdAt" TIMESTAMP,
        "CD_fullName" ENCRYPTED STRING,
        "CD_fullName_ckAsset" ASSET,
        "CD_goodToKnow" ENCRYPTED STRING,
        "CD_goodToKnow_ckAsset" ASSET,
        "CD_id" STRING,
        "CD_loves" ENCRYPTED STRING,
        "CD_loves_ckAsset" ASSET,
        "CD_mailingAddress" ENCRYPTED STRING,
        "CD_mailingAddress_ckAsset" ASSET,
        "CD_manualPhone" ENCRYPTED STRING,
        "CD_manualPhone_ckAsset" ASSET,
        "CD_name" ENCRYPTED STRING,
        "CD_name_ckAsset" ASSET,
        "CD_photoFiles" STRING,
        "CD_photoFiles_ckAsset" ASSET,
        "CD_relationship" ENCRYPTED STRING,
        "CD_relationship_ckAsset" ASSET,
        "CD_ringRaw" STRING,
        "CD_ringRaw_ckAsset" ASSET,
        "CD_showAgeOnCard" INT64,
        "CD_sizes" ENCRYPTED STRING,
        "CD_sizes_ckAsset" ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Photo (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        "CD_entityName" STRING QUERYABLE,
        "CD_createdAt" TIMESTAMP,
        "CD_data" BYTES,
        "CD_data_ckAsset" ASSET,
        "CD_id" STRING,
        "CD_name" ENCRYPTED STRING,
        "CD_name_ckAsset" ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Wish (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        "CD_entityName" STRING QUERYABLE,
        "CD_capturedAt" TIMESTAMP,
        "CD_id" STRING,
        "CD_imageFile" STRING,
        "CD_imageFile_ckAsset" ASSET,
        "CD_person" STRING,
        "CD_statusRaw" STRING,
        "CD_statusRaw_ckAsset" ASSET,
        "CD_text" ENCRYPTED STRING,
        "CD_text_ckAsset" ASSET,
        "CD_url" ENCRYPTED STRING,
        "CD_url_ckAsset" ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );
